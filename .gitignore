# compiled dependencies (built by scripts/install.sh)
deps/
libs/*
!libs/dkjson.lua

# local config used for testing
config

# Generated service/nix files (machine-specific, created by install.sh)
#
# Globs rather than exact names, because the generated files are now named
# after the service, and the service is named after the mailbox — so a
# mailbox at ~/notes/rmail produces rmail-home-ritz-notes-rmail.service
# rather than rmail.service. Listing exact names left every second mailbox's
# generated files showing up as untracked noise. (Re #377.)
rmail*.nix
rmail*.service
rmail*-run
rmail*-init

# Build temp files
.build-tmp/

# Android SDK path (machine-specific)
clients/android/local.properties
# Android build outputs
clients/android/.gradle/
clients/android/app/build/
clients/android/build/

# Generated docs (source of truth is docs/.templates/)
docs/*.md
!docs/looking-for-docs.md
