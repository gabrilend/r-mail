# compiled dependencies (built by scripts/install.sh)
deps/
libs/*
!libs/dkjson.lua
# the shared zip library, plain Lua carried with rmail (#309): a copy made
# by my-libs/zip/install-into, checked by scripts/test-zip-library.sh
!libs/zip-*.lua
!libs/zip-library.version

# local config used for testing
config

# Generated service/nix files (machine-specific, created by install.sh)
#
# Globs rather than exact names, because the generated files are now named
# after the service, and the service is named after the mailbox — so a
# mailbox at ~/notes/rmail produces rmail-home-ritz-notes-rmail.service
# rather than rmail.service. Listing exact names left every second mailbox's
# generated files showing up as untracked noise. (Re #612.)
#
# Anchored to the project root and not tied to an "rmail" prefix, because
# --service-name lets the owner pick any name (this machine's services are
# kuvalu-mail and kuvalu-notes), and install.sh writes <service>.nix,
# <service>.service, <service>-run and <service>-init into the root.  No
# tracked file at the root has any of these shapes.
/*.nix
/*.service
/*-run
/*-init

# This machine's restart script, built from scripts/.templates/ (#622).
# Its list of mailbox services belongs to this machine alone.
/scripts/restart-mailboxes.sh

# Build temp files
.build-tmp/

# Android SDK path (machine-specific)
clients/android/local.properties
# Android build outputs
clients/android/.gradle/
clients/android/app/build/
clients/android/build/

# Generated docs (source of truth is docs/.templates/)
docs/*.md
!docs/looking-for-docs.md
# written by hand, not generated: the tree of every document, and the phases
!docs/table-of-contents.md

# Conversation pages, rebuilt before every push (install-pages-hook)
**/llm-transcripts/HTML/
