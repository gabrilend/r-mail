[Unit]
Description=rmail messaging daemon (@MAILBOX@)
After=network.target

[Service]
Type=simple
User=@USER@
ExecStart=@LUA_BIN@ @ROOT@/rmail.lua @CONFIG_FILE@
Restart=on-failure
RestartSec=5
StandardOutput=append:@SERVICE_LOG@
StandardError=append:@SERVICE_LOG@

[Install]
WantedBy=multi-user.target
