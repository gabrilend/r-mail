<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone by way of Android backup (#392 B19).  The app's
  storage holds each mailbox's token, the key that encrypts its traffic,
  along with the mail itself.  allowBackup="false" covers cloud backup; these
  rules also cover Android 12+'s device-to-device transfer, which ignores it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
